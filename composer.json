{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "archilex/filament-filter-sets": "^5.3",
        "awcodes/filament-versions": "4.x-dev",
        "calebporzio/sushi": "^2.4",
        "diogogpinto/filament-auth-ui-enhancer": "dev-main",
        "fakerphp/faker": "^1.23",
        "filament/filament": "^5.0",
        "graham-campbell/github": "^13.0",
        "guzzlehttp/guzzle": "^7.5",
        "jeremykenedy/laravel-packagist": "^1.0",
        "lara-zeus/accordion": "^3.0",
        "lara-zeus/activity-timeline": "^5.0",
        "lara-zeus/akin": "^3.0",
        "lara-zeus/athena": "^3.0",
        "lara-zeus/bolt": "^5.0",
        "lara-zeus/bolt-pro": "^5.0",
        "lara-zeus/boredom": "^3.0",
        "lara-zeus/chaos": "^3.0",
        "lara-zeus/core": "^5.0",
        "lara-zeus/delia": "^3.0",
        "lara-zeus/popover": "^3.0",
        "lara-zeus/dynamic-dashboard": "^5.0",
        "lara-zeus/filament-locationpickr-field": "^5.0",
        "lara-zeus/filament-plugin-tools": "^3.0",
        "lara-zeus/hades": "^2.0",
        "lara-zeus/helen": "^3.0",
        "lara-zeus/hera": "^2.0",
        "lara-zeus/inline-chart": "^3.0",
        "lara-zeus/installer": "^1.0",
        "lara-zeus/laravel-seo": "^2.0",
        "lara-zeus/list-group": "^3.0",
        "lara-zeus/mark": "dev-filament-5",
        "lara-zeus/matrix-choice": "^5.0",
        "lara-zeus/progress": "^3.0",
        "lara-zeus/qr": "^3.0",
        "lara-zeus/quantity": "^3.0",
        "lara-zeus/replies": "^3.0",
        "lara-zeus/simple-qrcode": "^5.0",
        "lara-zeus/sky": "^5.0",
        "lara-zeus/spatie-translatable": "^2.0",
        "lara-zeus/thunder": "^5.0",
        "lara-zeus/tiles": "^3.0",
        "lara-zeus/torch-filament": "^3.0",
        "lara-zeus/wind": "^5.0",
        "laravel/framework": "^12.0",
        "laravel/prompts": "^0.3",
        "laravel/sanctum": "^4.0",
        "livewire/livewire": "^4.0",
        "sentry/sentry-laravel": "^4.15",
        "swisnl/filament-backgrounds": "dev-main",
        "torchlight/engine": "^0.1.0",
        "torchlight/torchlight-laravel": "^0.6"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.13",
        "laravel/tinker": "^2.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan vendor:publish --tag=zeus-assets --ansi --force",
            "@php artisan demo:filament",
            "@php artisan filament:upgrade"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https://filament-filter-sets.composer.sh"
        },
        {
            "type": "github",
            "url": "git@github.com:lara-zeus/hades.git"
        },
        {
            "type": "github",
            "url": "git@github.com:lara-zeus/hera.git"
        },
        {
            "type": "github",
            "url": "git@github.com:lara-zeus/translatable.git"
        },
        {
            "type": "github",
            "url": "git@github.com:lara-zeus/tiles.git"
        },
        {
            "type": "github",
            "url": "git@github.com:lara-zeus/hermes.git"
        },
        {
            "type": "github",
            "url": "git@github.com:lara-zeus/helen.git"
        },
        {
            "type": "github",
            "url": "git@github.com:lara-zeus/thunder.git"
        },
        {
            "type": "github",
            "url": "git@github.com:lara-zeus/athena.git"
        },
        {
            "type": "github",
            "url": "git@github.com:lara-zeus/bolt-pro.git"
        }
    ]
}
